DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=False

# Preferred in production (Render)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Database (Neon PostgreSQL)
DB_NAME=pymeweb
DB_USER=neondb_owner
DB_PASSWORD=your-neon-password
DB_HOST=ep-wispy-river-ackhbou0-pooler.sa-east-1.aws.neon.tech
DB_PORT=5432
DB_SSLMODE=require

# Allowed Hosts
ALLOWED_HOSTS=localhost,127.0.0.1,pymeweb-api.onrender.com,pymeweb.onrender.com

# Security
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True

# CORS
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://pymeweb.onrender.com,http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=https://pymeweb.onrender.com,https://pymeweb-api.onrender.com

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
